{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(openspec:*)",
      "Bash(npm run lint)",
      "Bash(npm run test:run:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(npm run db:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(docker-compose down:*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env)"
    ]
  }
}
